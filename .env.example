# Resend API key (https://resend.com) — required only when email delivery is enabled
RESEND_API_KEY=

# Email address that receives form submissions
CONTACT_TO_EMAIL=

# Verified sender address/domain in Resend (e.g. DeskScholar <forms@yourdomain.com>)
CONTACT_FROM_EMAIL=

# Set to "true" only after the variables above are configured
EMAIL_DELIVERY_ENABLED=false

# Formspree endpoint for the Early Access + Contact forms (public form URL)
VITE_FORMSPREE_ENDPOINT=

# Cloudflare Stream source for the prototype demo video (public URL/UID only —
# NEVER an API token). Optional: when unset, the approved demo video baked into
# src/data/videoConfig.ts is used. Supported formats (normalised to the HLS
# manifest so playback-speed controls work):
#   https://iframe.videodelivery.net/<video-uid>
#   https://videodelivery.net/<video-uid>/manifest/video.m3u8
#   https://<customer-subdomain>.cloudflarestream.com/<video-uid>/iframe
#   https://<customer-subdomain>.cloudflarestream.com/<video-uid>/manifest/video.m3u8
VITE_DEMO_VIDEO_EMBED_URL=

# Production site URL for canonical tags, OG, sitemap, robots.txt
VITE_SITE_URL=https://www.deskscholar.com
